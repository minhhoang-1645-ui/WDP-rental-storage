PORT=3000
# Comma-separated browser origins; include Expo web when it is used.
# For a phone opening Expo web on LAN, also include the actual http://YOUR_LAN_IP:8081 origin.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
# Public browser origin used in guest claim links and payment redirects.
FRONTEND_PUBLIC_URL=http://localhost:5173
# Leave empty until the team has real sender settings. Then choose smtp or resend.
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=NestBox Storage
EMAIL_FROM_ADDRESS=
# Development/test script only. Never used by Guest Booking runtime flow.
# EMAIL_TEST_RECIPIENT=recipient-for-manual-email-test@example.com
# Render / production alternative:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
DATABASE_URL=postgresql://postgres:postgres@localhost:6543/wdp_storage?pgbouncer=true
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/wdp_storage
DATABASE_CONNECT_ON_STARTUP=true
# Keep disabled until the prepared UnitStaffAssignment migration has been reviewed and deployed.
UNIT_STAFF_ASSIGNMENTS_ENABLED=false
INQUIRY_LOOKUP_SECRET=replace-with-at-least-32-random-characters
SEED_MANAGER_EMAIL=manager@example.test
SEED_MANAGER_PASSWORD=replace-with-a-strong-development-password
SEED_MANAGER_NAME=WDP Demo Manager
SEED_MANAGER_PHONE=0900000000
WDP_BANK_NAME=
DEMO_PAYMENT_ENABLED=false
WDP_BANK_CODE=
WDP_BANK_ACCOUNT_NUMBER=
WDP_BANK_ACCOUNT_NAME=

# PDF issuer: keep blank until the real contracting entity has approved its terms.
# Missing fields or approval=false => immutable documents visibly marked DỰ THẢO.
CONTRACT_LEGAL_NAME=
CONTRACT_TAX_CODE=
CONTRACT_ADDRESS=
CONTRACT_REPRESENTATIVE=
CONTRACT_TERMS_VERSION=NESTBOX-RENTAL-V2
CONTRACT_TERMS_APPROVED=false
# Keep merchant credentials empty until sandbox onboarding is complete.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/customer/payments/vnpay-return
# Configure VNPay IPN separately as: https://your-backend-domain.example/api/payments/vnpay/ipn

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum StorageCondition {
  STANDARD
  AIR_CONDITIONED
}

enum CatalogStatus {
  AVAILABLE
  LIMITED
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}

enum PeriodMode {
  DURATION
  CUSTOM_DATES
}

enum InquiryStatus {
  PENDING_CONTACT
  CONTACTED
  IN_REVIEW
  CLOSED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  passwordHash       String
  fullName           String
  phone              String?
  role               UserRole         @default(CUSTOMER)
  inquiries          ContactInquiry[] @relation("InquiryCustomer")
  processedInquiries ContactInquiry[] @relation("InquiryProcessor")
  reservations       Reservation[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Facility {
  id           String           @id @default(cuid())
  code         String           @unique
  name         String
  address      String
  storageTypes StorageType[]
  inquiries    ContactInquiry[]
  reservations Reservation[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model StorageType {
  id             String               @id
  facilityId     String
  facility       Facility             @relation(fields: [facilityId], references: [id])
  code           String               @unique
  name           String
  sizeId         String
  sizeName       String
  kicker         String
  condition      StorageCondition
  catalogStatus  CatalogStatus        @default(AVAILABLE)
  widthCm        Int
  lengthCm       Int
  heightCm       Int
  roomEquivalent String
  capacity       String
  boxCount       String
  suitableItems  Json
  image          String
  imageAlt       String
  floor          String
  access         String
  features       Json
  monthlyRate    Decimal?             @db.Decimal(12, 2)
  depositMonths  Int?
  units          StorageUnit[]
  inquiries      ContactInquiry[]
  reservations   Reservation[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([facilityId, sizeId, condition])
}

model StorageUnit {
  id               String            @id @default(cuid())
  storageTypeId    String
  storageType      StorageType       @relation(fields: [storageTypeId], references: [id])
  unitNumber       String            @unique
  floor            String?
  zone             String?
  row              Int?
  position         Int?
  status           UnitStatus        @default(AVAILABLE)
  reservationUnits ReservationUnit[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([storageTypeId, status])
  @@index([storageTypeId, row, position])
}

model ContactInquiry {
  id                 String        @id @default(cuid())
  inquiryCode        String        @unique
  lookupTokenHash    String
  customerId         String?
  customer           User?         @relation("InquiryCustomer", fields: [customerId], references: [id])
  facilityId         String
  facility           Facility      @relation(fields: [facilityId], references: [id])
  storageTypeId      String
  storageType        StorageType   @relation(fields: [storageTypeId], references: [id])
  fullName           String
  email              String
  phone              String
  quantity           Int
  startDate          DateTime      @db.Date
  endDate            DateTime      @db.Date
  periodMode         PeriodMode
  durationMonths     Int?
  adjacentPreference Boolean       @default(false)
  availabilitySnapshot Json
  quoteSnapshot      Json
  status             InquiryStatus @default(PENDING_CONTACT)
  customerNotes      String?
  internalNotes      String?
  processedById      String?
  processedBy        User?         @relation("InquiryProcessor", fields: [processedById], references: [id])
  contactedAt        DateTime?
  idempotencyKey     String        @unique
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([customerId])
}

model Reservation {
  id                 String            @id @default(cuid())
  reservationCode    String            @unique
  customerId         String
  customer           User              @relation(fields: [customerId], references: [id])
  facilityId         String
  facility           Facility          @relation(fields: [facilityId], references: [id])
  storageTypeId      String
  storageType        StorageType       @relation(fields: [storageTypeId], references: [id])
  quantity           Int
  startDate          DateTime           @db.Date
  endDate            DateTime           @db.Date
  periodMode         PeriodMode
  durationMonths     Int?
  adjacentPreference Boolean            @default(false)
  availabilitySnapshot Json
  quoteSnapshot      Json
  status             ReservationStatus @default(PENDING)
  notes              String?
  quotedAmount       Decimal?           @db.Decimal(12, 2)
  expiresAt          DateTime?
  confirmedAt        DateTime?
  idempotencyKey     String             @unique
  units              ReservationUnit[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([customerId, createdAt])
  @@index([storageTypeId, status, startDate, endDate])
}

model ReservationUnit {
  id               String      @id @default(cuid())
  reservationId    String
  reservation      Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  storageUnitId    String
  storageUnit      StorageUnit @relation(fields: [storageUnitId], references: [id])
  plannedStartDate DateTime    @db.Date
  plannedEndDate   DateTime    @db.Date
  actualVacatedAt  DateTime?
  releasedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([reservationId, storageUnitId])
  @@index([storageUnitId, plannedStartDate, plannedEndDate])
}

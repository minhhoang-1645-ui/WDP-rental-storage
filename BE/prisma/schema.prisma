generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
}

enum TransferReason {
  UNIT_ISSUE
  FACILITY_EQUIPMENT_FAILURE
  OPERATIONAL_RELOCATION
  OTHER
}

enum StorageCondition {
  STANDARD
  AIR_CONDITIONED
}

enum CatalogStatus {
  AVAILABLE
  LIMITED
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}

enum PeriodMode {
  DURATION
  CUSTOM_DATES
}

enum InquiryStatus {
  PENDING_CONTACT
  CONTACTED
  IN_REVIEW
  CLOSED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ContractStatus {
  PENDING_PAYMENT
  READY_FOR_HANDOVER
  ACTIVE
  COMPLETED
}

enum InvoiceType {
  INITIAL
  RECURRING
  RENEWAL
  SETTLEMENT
}

enum InvoiceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  VNPAY
}

enum GuestBookingStatus {
  PENDING_VERIFICATION
  VERIFIED
  CLAIMED
  EXPIRED
  CANCELLED
}

enum PaymentProvider {
  VNPAY
}

enum OnlinePaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum AdditionalServiceKind {
  PURCHASE
  RENTAL
}

enum AdditionalServiceBillingUnit {
  ONE_TIME
  DAY
  MONTH
}

enum AdditionalServiceFulfillmentStatus {
  RESERVED
  FULFILLED
  RELEASED
}

enum PaymentSubmissionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum PaymentSubmissionMethod {
  BANK_TRANSFER
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum RenewalStatus {
  PENDING
  APPROVED_PENDING_PAYMENT
  COMPLETED
  REJECTED
}

enum RenewalPaymentPlan {
  PAY_MONTHLY
  PREPAID
}

enum ReturnStatus {
  REQUESTED
  INSPECTION_IN_PROGRESS
  ISSUE_FOUND
  PENDING_SETTLEMENT
  COMPLETED
}

enum InspectionResult {
  PENDING
  PASS
  ISSUE_FOUND
}

enum InspectionIssueType {
  NORMAL_WEAR
  FACILITY_FAULT
  CUSTOMER_DAMAGE
  CLEANING_REQUIRED
  LOST_KEY_OR_ACCESS_ITEM
  OTHER
}

enum DepositSettlementStatus {
  PENDING_REVIEW
  APPROVED
  AWAITING_OUTSTANDING_PAYMENT
  SETTLED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  AWAITING_VERIFICATION
  COMPLETED
}

enum MaintenanceSource {
  RETURN_INSPECTION
  MANUAL
}

enum MaintenanceCategory {
  UNIT_DAMAGE
  CLEANING
  LOCK_OR_ACCESS
  FACILITY_EQUIPMENT
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
}

enum SupportCategory {
  UNIT_ISSUE
  LOCK_OR_KEY_ISSUE
  ACCESS_CODE_ISSUE
  FACILITY_EQUIPMENT_FAILURE
  PAYMENT_SUPPORT
  STORED_ITEM_CONCERN
  OTHER
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
}

enum SupportStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ESCALATED
  RESOLVED
}

enum SupportResolutionType {
  ON_SITE_RESOLVED
  CUSTOMER_GUIDANCE
  ACCESS_RESTORED
  PAYMENT_GUIDANCE
  MANAGER_RESOLVED
  TRANSFER_RECOMMENDED
  NO_ACTION_REQUIRED
  OTHER
}

enum StockMovementType {
  IN
  OUT
}

enum StockMovementStatus {
  REQUESTED
  ASSIGNED
  COMPLETED
  CANCELLED
}

model AdditionalService {
  id            String                       @id @default(cuid())
  code          String                       @unique
  name          String
  description   String?
  kind          AdditionalServiceKind
  billingUnit   AdditionalServiceBillingUnit
  unitPrice     BigInt?
  imageUrl      String?
  imageAlt      String?
  isActive      Boolean                      @default(true)
  reservations  ReservationService[]
  guestBookings GuestBookingService[]
  inventory     AdditionalServiceInventory?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@index([isActive, name])
}

model AdditionalServiceInventory {
  id                  String            @id @default(cuid())
  additionalServiceId String            @unique
  additionalService   AdditionalService @relation(fields: [additionalServiceId], references: [id], onDelete: Cascade)
  stockOnHand         Int?
  rentalCapacity      Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model User {
  id                          String                     @id @default(cuid())
  email                       String                     @unique
  passwordHash                String
  fullName                    String
  phone                       String?
  role                        UserRole                   @default(CUSTOMER)
  accountStatus               AccountStatus              @default(ACTIVE)
  inquiries                   ContactInquiry[]           @relation("InquiryCustomer")
  processedInquiries          ContactInquiry[]           @relation("InquiryProcessor")
  reservations                Reservation[]
  recordedPayments            Payment[]                  @relation("PaymentRecorder")
  paymentSubmissions          PaymentSubmission[]        @relation("PaymentSubmissionCustomer")
  reviewedPaymentSubmissions  PaymentSubmission[]        @relation("PaymentSubmissionReviewer")
  claimedGuestBookings        GuestBookingRequest[]      @relation("GuestBookingClaimer")
  onlinePaymentTransactions   OnlinePaymentTransaction[]
  requestedAppointments       HandoverAppointment[]      @relation("AppointmentRequester")
  confirmedAppointments       HandoverAppointment[]      @relation("AppointmentConfirmer")
  completedAppointments       HandoverAppointment[]      @relation("AppointmentCompleter")
  requestedRenewals           RenewalRequest[]           @relation("RenewalRequester")
  reviewedRenewals            RenewalRequest[]           @relation("RenewalReviewer")
  storedItems                 StoredItem[]                @relation("StoredItemCustomer")
  requestedStockMovements     StockMovement[]             @relation("StockMovementCustomer")
  assignedStockMovements      StockMovement[]             @relation("StockMovementAssignee")
  assignedByStockMovements    StockMovement[]             @relation("StockMovementAssigner")
  completedStockMovements     StockMovement[]             @relation("StockMovementCompleter")
  requestedReturns            ReturnRequest[]            @relation("ReturnRequester")
  startedReturns              ReturnRequest[]            @relation("ReturnInspectionStarter")
  completedReturns            ReturnRequest[]            @relation("ReturnCompleter")
  physicallyReturnedReturns   ReturnRequest[]            @relation("PhysicalReturnCompleter")
  returnInspections           ReturnInspection[]         @relation("ReturnInspector")
  reviewedDepositSettlements  DepositSettlement[]        @relation("DepositSettlementReviewer")
  settledDepositSettlements   DepositSettlement[]        @relation("DepositSettlementCompleter")
  reviewedSettlementIssues    DepositSettlementIssue[]   @relation("SettlementIssueReviewer")
  reportedMaintenanceRequests MaintenanceRequest[]       @relation("MaintenanceReporter")
  assignedMaintenanceRequests MaintenanceRequest[]       @relation("MaintenanceAssignee")
  verifiedMaintenanceRequests MaintenanceRequest[]       @relation("MaintenanceVerifier")
  customerSupportRequests     SupportRequest[]           @relation("SupportCustomer")
  assignedSupportRequests     SupportRequest[]           @relation("SupportAssignee")
  escalatedSupportRequests    SupportRequest[]           @relation("SupportEscalator")
  resolvedSupportRequests     SupportRequest[]           @relation("SupportResolver")
  requestedTransfers          TransferRequest[]          @relation("TransferRequester")
  approvedTransfers           TransferRequest[]          @relation("TransferApprover")
  completedTransfers          TransferRequest[]          @relation("TransferCompleter")
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
}

model Facility {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  address              String
  storageTypes         StorageType[]
  inquiries            ContactInquiry[]
  reservations         Reservation[]
  guestBookingRequests GuestBookingRequest[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model StorageType {
  id                   String                @id
  facilityId           String
  facility             Facility              @relation(fields: [facilityId], references: [id])
  code                 String                @unique
  name                 String
  sizeId               String
  sizeName             String
  kicker               String
  condition            StorageCondition
  catalogStatus        CatalogStatus         @default(AVAILABLE)
  widthCm              Int
  lengthCm             Int
  heightCm             Int
  roomEquivalent       String
  capacity             String
  boxCount             String
  suitableItems        Json
  image                String
  imageAlt             String
  floor                String
  access               String
  features             Json
  monthlyRate          Decimal?              @db.Decimal(12, 2)
  depositMonths        Int?
  minRentalDays        Int?
  allowDailyRental     Boolean               @default(false)
  units                StorageUnit[]
  inquiries            ContactInquiry[]
  reservations         Reservation[]
  guestBookingRequests GuestBookingRequest[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([facilityId, sizeId, condition])
}

model StorageUnit {
  id                  String               @id @default(cuid())
  storageTypeId       String
  storageType         StorageType          @relation(fields: [storageTypeId], references: [id])
  unitNumber          String               @unique
  floor               String?
  zone                String?
  row                 Int?
  position            Int?
  status              UnitStatus           @default(AVAILABLE)
  reservationUnits    ReservationUnit[]
  returnInspections   ReturnInspection[]
  maintenanceRequests MaintenanceRequest[]
  supportRequests     SupportRequest[]
  outgoingTransfers   TransferRequest[]    @relation("TransferSourceUnit")
  incomingTransfers   TransferRequest[]    @relation("TransferDestinationUnit")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([storageTypeId, status])
  @@index([storageTypeId, row, position])
}

model ContactInquiry {
  id                   String        @id @default(cuid())
  inquiryCode          String        @unique
  lookupTokenHash      String
  customerId           String?
  customer             User?         @relation("InquiryCustomer", fields: [customerId], references: [id])
  facilityId           String
  facility             Facility      @relation(fields: [facilityId], references: [id])
  storageTypeId        String
  storageType          StorageType   @relation(fields: [storageTypeId], references: [id])
  fullName             String
  email                String
  phone                String
  quantity             Int
  startDate            DateTime      @db.Date
  endDate              DateTime      @db.Date
  periodMode           PeriodMode
  durationMonths       Int?
  adjacentPreference   Boolean       @default(false)
  availabilitySnapshot Json
  quoteSnapshot        Json
  status               InquiryStatus @default(PENDING_CONTACT)
  customerNotes        String?
  internalNotes        String?
  processedById        String?
  processedBy          User?         @relation("InquiryProcessor", fields: [processedById], references: [id])
  contactedAt          DateTime?
  idempotencyKey       String        @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([customerId])
}

model GuestBookingRequest {
  id                   String                @id @default(cuid())
  bookingCode          String                @unique
  fullName             String
  email                String
  phone                String
  facilityId           String
  facility             Facility              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  storageTypeId        String
  storageType          StorageType           @relation(fields: [storageTypeId], references: [id], onDelete: Restrict)
  quantity             Int
  startDate            DateTime              @db.Date
  endDate              DateTime              @db.Date
  paymentPlan          RenewalPaymentPlan
  quoteSnapshot        Json
  availabilitySnapshot Json
  services             GuestBookingService[]
  status               GuestBookingStatus    @default(PENDING_VERIFICATION)
  emailVerifiedAt      DateTime?
  claimedByUserId      String?
  claimedBy            User?                 @relation("GuestBookingClaimer", fields: [claimedByUserId], references: [id], onDelete: Restrict)
  reservationId        String?               @unique
  reservation          Reservation?          @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  claimTokenHash       String?               @unique
  claimTokenExpiresAt  DateTime?
  idempotencyKey       String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([email, status])
  @@index([status, createdAt])
  @@index([storageTypeId, startDate, endDate])
}

model Reservation {
  id                   String                @id @default(cuid())
  reservationCode      String                @unique
  customerId           String
  customer             User                  @relation(fields: [customerId], references: [id])
  facilityId           String
  facility             Facility              @relation(fields: [facilityId], references: [id])
  storageTypeId        String
  storageType          StorageType           @relation(fields: [storageTypeId], references: [id])
  quantity             Int
  startDate            DateTime              @db.Date
  endDate              DateTime              @db.Date
  periodMode           PeriodMode
  durationMonths       Int?
  adjacentPreference   Boolean               @default(false)
  availabilitySnapshot Json
  quoteSnapshot        Json
  status               ReservationStatus     @default(PENDING)
  notes                String?
  quotedAmount         Decimal?              @db.Decimal(12, 2)
  expiresAt            DateTime?
  confirmedAt          DateTime?
  idempotencyKey       String                @unique
  units                ReservationUnit[]
  contracts            RentalContract[]
  invoices             Invoice[]
  appointments         HandoverAppointment[]
  renewals             RenewalRequest[]
  returns              ReturnRequest[]
  supportRequests      SupportRequest[]
  transferRequests     TransferRequest[]
  guestBookingRequest  GuestBookingRequest?
  services             ReservationService[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([customerId, createdAt])
  @@index([storageTypeId, status, startDate, endDate])
}

model ReservationService {
  id                  String                              @id @default(cuid())
  reservationId       String
  reservation         Reservation                         @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  additionalServiceId String
  additionalService   AdditionalService                   @relation(fields: [additionalServiceId], references: [id], onDelete: Restrict)
  serviceCodeSnapshot String
  serviceNameSnapshot String
  serviceKindSnapshot AdditionalServiceKind
  billingUnitSnapshot AdditionalServiceBillingUnit
  fulfillmentStatus   AdditionalServiceFulfillmentStatus?
  unitPriceSnapshot   BigInt
  quantity            Int
  serviceStartDate    DateTime?                           @db.Date
  serviceEndDate      DateTime?                           @db.Date
  amountSnapshot      BigInt
  createdAt           DateTime                            @default(now())

  @@unique([reservationId, additionalServiceId])
  @@index([reservationId, createdAt])
  @@index([additionalServiceId])
}

model GuestBookingService {
  id                    String              @id @default(cuid())
  guestBookingRequestId String
  guestBookingRequest   GuestBookingRequest @relation(fields: [guestBookingRequestId], references: [id], onDelete: Cascade)
  additionalServiceId   String
  additionalService     AdditionalService   @relation(fields: [additionalServiceId], references: [id], onDelete: Restrict)
  quantity              Int
  serviceStartDate      DateTime?           @db.Date
  serviceEndDate        DateTime?           @db.Date
  createdAt             DateTime            @default(now())

  @@unique([guestBookingRequestId, additionalServiceId])
  @@index([additionalServiceId])
}

model ReservationUnit {
  id                String            @id @default(cuid())
  reservationId     String
  reservation       Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  storageUnitId     String
  storageUnit       StorageUnit       @relation(fields: [storageUnitId], references: [id])
  plannedStartDate  DateTime          @db.Date
  plannedEndDate    DateTime          @db.Date
  actualVacatedAt   DateTime?
  releasedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  contract          RentalContract?
  outgoingTransfers TransferRequest[] @relation("TransferSourceAllocation")
  incomingTransfer  TransferRequest?  @relation("TransferDestinationAllocation")

  @@unique([reservationId, storageUnitId])
  @@index([storageUnitId, plannedStartDate, plannedEndDate])
}

model RentalContract {
  id                String             @id @default(cuid())
  contractCode      String             @unique
  reservationId     String
  reservation       Reservation        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  reservationUnitId String             @unique
  reservationUnit   ReservationUnit    @relation(fields: [reservationUnitId], references: [id], onDelete: Restrict)
  status            ContractStatus     @default(PENDING_PAYMENT)
  startDate         DateTime           @db.Date
  endDate           DateTime           @db.Date
  activatedAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  returnInspections ReturnInspection[]
  supportRequests   SupportRequest[]
  transferRequests  TransferRequest[]
  storedItems       StoredItem[]
  stockMovements    StockMovement[]

  @@index([reservationId, status])
  @@index([status, createdAt])
}

model StoredItem {
  id               String              @id @default(cuid())
  itemCode         String              @unique
  customerUserId   String
  customer         User                @relation("StoredItemCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  rentalContractId String
  rentalContract   RentalContract      @relation(fields: [rentalContractId], references: [id], onDelete: Restrict)
  name             String
  unit             String
  balance          Int                 @default(0)
  note             String?
  movementLines    StockMovementLine[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([customerUserId, rentalContractId, name])
  @@index([rentalContractId, balance])
}

model StockMovement {
  id                    String              @id @default(cuid())
  movementCode          String              @unique
  type                  StockMovementType
  status                StockMovementStatus @default(REQUESTED)
  customerUserId        String
  customer              User                @relation("StockMovementCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  rentalContractId      String
  rentalContract        RentalContract      @relation(fields: [rentalContractId], references: [id], onDelete: Restrict)
  scheduledAt           DateTime?
  note                  String?
  assignedStaffUserId   String?
  assignedStaff         User?               @relation("StockMovementAssignee", fields: [assignedStaffUserId], references: [id], onDelete: Restrict)
  assignedByUserId      String?
  assignedBy            User?               @relation("StockMovementAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  assignedAt            DateTime?
  completedByUserId     String?
  completedBy           User?               @relation("StockMovementCompleter", fields: [completedByUserId], references: [id], onDelete: Restrict)
  completedAt           DateTime?
  completionNote        String?
  idempotencyKey        String              @unique
  lines                 StockMovementLine[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([customerUserId, createdAt])
  @@index([rentalContractId, createdAt])
  @@index([assignedStaffUserId, status, scheduledAt])
  @@index([status, scheduledAt, id])
}

model StockMovementLine {
  id              String        @id @default(cuid())
  stockMovementId String
  stockMovement   StockMovement @relation(fields: [stockMovementId], references: [id], onDelete: Cascade)
  storedItemId    String
  storedItem      StoredItem    @relation(fields: [storedItemId], references: [id], onDelete: Restrict)
  requestedQty    Int
  actualQty       Int?
  note            String?
  createdAt       DateTime      @default(now())

  @@unique([stockMovementId, storedItemId])
  @@index([storedItemId, createdAt])
}

model ReturnRequest {
  id                     String             @id @default(cuid())
  returnCode             String             @unique
  reservationId          String
  reservation            Reservation        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  status                 ReturnStatus       @default(REQUESTED)
  requestedByUserId      String
  requestedBy            User               @relation("ReturnRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  requestedAt            DateTime           @default(now())
  inspectionStartedAt    DateTime?
  inspectionStartedById  String?
  inspectionStartedBy    User?              @relation("ReturnInspectionStarter", fields: [inspectionStartedById], references: [id], onDelete: Restrict)
  completedAt            DateTime?
  completedByUserId      String?
  completedBy            User?              @relation("ReturnCompleter", fields: [completedByUserId], references: [id], onDelete: Restrict)
  physicallyReturnedAt   DateTime?
  physicallyReturnedById String?
  physicallyReturnedBy   User?              @relation("PhysicalReturnCompleter", fields: [physicallyReturnedById], references: [id], onDelete: Restrict)
  note                   String?
  idempotencyKey         String             @unique
  activeKey              String?            @unique
  inspections            ReturnInspection[]
  depositSettlement      DepositSettlement?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([reservationId, createdAt])
  @@index([status, createdAt])
}

model ReturnInspection {
  id                 String                  @id @default(cuid())
  returnRequestId    String
  returnRequest      ReturnRequest           @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  rentalContractId   String
  rentalContract     RentalContract          @relation(fields: [rentalContractId], references: [id], onDelete: Restrict)
  storageUnitId      String
  storageUnit        StorageUnit             @relation(fields: [storageUnitId], references: [id], onDelete: Restrict)
  result             InspectionResult        @default(PENDING)
  issueType          InspectionIssueType?
  conditionNote      String?
  issueNote          String?
  inspectedByUserId  String?
  inspectedBy        User?                   @relation("ReturnInspector", fields: [inspectedByUserId], references: [id], onDelete: Restrict)
  inspectedAt        DateTime?
  settlementIssue    DepositSettlementIssue?
  maintenanceRequest MaintenanceRequest?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([returnRequestId, rentalContractId])
  @@unique([returnRequestId, storageUnitId])
  @@index([storageUnitId, result])
  @@index([rentalContractId])
}

model MaintenanceRequest {
  id                       String              @id @default(cuid())
  maintenanceCode          String              @unique
  storageUnitId            String
  storageUnit              StorageUnit         @relation(fields: [storageUnitId], references: [id], onDelete: Restrict)
  source                   MaintenanceSource
  returnInspectionId       String?             @unique
  returnInspection         ReturnInspection?   @relation(fields: [returnInspectionId], references: [id], onDelete: Restrict)
  category                 MaintenanceCategory
  priority                 MaintenancePriority @default(MEDIUM)
  status                   MaintenanceStatus   @default(OPEN)
  description              String
  reportedByUserId         String
  reportedBy               User                @relation("MaintenanceReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  assignedStaffUserId      String?
  assignedStaff            User?               @relation("MaintenanceAssignee", fields: [assignedStaffUserId], references: [id], onDelete: Restrict)
  startedAt                DateTime?
  workCompletedAt          DateTime?
  workNote                 String?
  verificationNote         String?
  verifiedByUserId         String?
  verifiedBy               User?               @relation("MaintenanceVerifier", fields: [verifiedByUserId], references: [id], onDelete: Restrict)
  verifiedAt               DateTime?
  activeKey                String?             @unique
  createIdempotencyKey     String              @unique
  lastAction               String?
  lastActionIdempotencyKey String?             @unique
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([status, priority, createdAt])
  @@index([storageUnitId, createdAt])
  @@index([assignedStaffUserId, status])
}

model Invoice {
  id                        String                     @id @default(cuid())
  invoiceCode               String                     @unique
  reservationId             String
  reservation               Reservation                @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  type                      InvoiceType                @default(INITIAL)
  billingCycle              Int?                       @default(1)
  renewalRequestId          String?
  renewalRequest            RenewalRequest?            @relation(fields: [renewalRequestId], references: [id], onDelete: Restrict)
  renewalCycle              Int?
  depositSettlementId       String?                    @unique
  depositSettlement         DepositSettlement?         @relation(fields: [depositSettlementId], references: [id], onDelete: Restrict)
  billingPeriodStart        DateTime?                  @db.Date
  billingPeriodEnd          DateTime?                  @db.Date
  dueAt                     DateTime?                  @db.Date
  status                    InvoiceStatus              @default(OPEN)
  rentalAmount              BigInt
  depositAmount             BigInt
  serviceAmount             BigInt                     @default(0)
  chargeAmount              BigInt                     @default(0)
  totalAmount               BigInt
  amountPaid                BigInt                     @default(0)
  balanceDue                BigInt
  currency                  String                     @default("VND")
  issuedAt                  DateTime                   @default(now())
  paidAt                    DateTime?
  payments                  Payment[]
  paymentSubmissions        PaymentSubmission[]
  onlinePaymentTransactions OnlinePaymentTransaction[]
  supportRequests           SupportRequest[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@unique([reservationId, billingCycle])
  @@unique([renewalRequestId, renewalCycle])
  @@index([status, issuedAt])
  @@index([type, dueAt])
  @@index([renewalRequestId, status])
  @@index([depositSettlementId, status])
}

model SupportRequest {
  id                       String                 @id @default(cuid())
  supportCode              String                 @unique
  customerUserId           String
  customer                 User                   @relation("SupportCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  reservationId            String
  reservation              Reservation            @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  rentalContractId         String?
  rentalContract           RentalContract?        @relation(fields: [rentalContractId], references: [id], onDelete: Restrict)
  storageUnitId            String?
  storageUnit              StorageUnit?           @relation(fields: [storageUnitId], references: [id], onDelete: Restrict)
  invoiceId                String?
  invoice                  Invoice?               @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  category                 SupportCategory
  priority                 SupportPriority        @default(MEDIUM)
  status                   SupportStatus          @default(OPEN)
  subject                  String
  description              String
  assignedStaffUserId      String?
  assignedStaff            User?                  @relation("SupportAssignee", fields: [assignedStaffUserId], references: [id], onDelete: Restrict)
  startedAt                DateTime?
  escalatedAt              DateTime?
  escalatedByUserId        String?
  escalatedBy              User?                  @relation("SupportEscalator", fields: [escalatedByUserId], references: [id], onDelete: Restrict)
  escalationReason         String?
  resolutionType           SupportResolutionType?
  resolutionNote           String?
  resolvedByUserId         String?
  resolvedBy               User?                  @relation("SupportResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict)
  resolvedAt               DateTime?
  idempotencyKey           String                 @unique
  lastAction               String?
  lastActionIdempotencyKey String?                @unique
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  transferRequests         TransferRequest[]

  @@index([customerUserId, createdAt])
  @@index([status, priority, createdAt])
  @@index([assignedStaffUserId, status])
  @@index([reservationId, createdAt])
  @@index([storageUnitId, status])
}

model TransferRequest {
  id                    String           @id @default(cuid())
  transferCode          String           @unique
  reservationId         String
  reservation           Reservation      @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  rentalContractId      String
  rentalContract        RentalContract   @relation(fields: [rentalContractId], references: [id], onDelete: Restrict)
  fromStorageUnitId     String
  fromStorageUnit       StorageUnit      @relation("TransferSourceUnit", fields: [fromStorageUnitId], references: [id], onDelete: Restrict)
  toStorageUnitId       String?
  toStorageUnit         StorageUnit?     @relation("TransferDestinationUnit", fields: [toStorageUnitId], references: [id], onDelete: Restrict)
  fromReservationUnitId String
  fromReservationUnit   ReservationUnit  @relation("TransferSourceAllocation", fields: [fromReservationUnitId], references: [id], onDelete: Restrict)
  toReservationUnitId   String?          @unique
  toReservationUnit     ReservationUnit? @relation("TransferDestinationAllocation", fields: [toReservationUnitId], references: [id], onDelete: Restrict)
  supportRequestId      String?
  supportRequest        SupportRequest?  @relation(fields: [supportRequestId], references: [id], onDelete: Restrict)
  reason                TransferReason
  status                TransferStatus   @default(REQUESTED)
  requestedByUserId     String
  requestedBy           User             @relation("TransferRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedByUserId      String?
  approvedBy            User?            @relation("TransferApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  completedByUserId     String?
  completedBy           User?            @relation("TransferCompleter", fields: [completedByUserId], references: [id], onDelete: Restrict)
  idempotencyKey        String           @unique
  approvedAt            DateTime?
  completedAt           DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([reservationId, createdAt])
  @@index([fromStorageUnitId, status])
  @@index([toStorageUnitId, status])
}

model DepositSettlement {
  id                   String                   @id @default(cuid())
  settlementCode       String                   @unique
  returnRequestId      String                   @unique
  returnRequest        ReturnRequest            @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  status               DepositSettlementStatus
  depositAmount        BigInt
  totalApprovedCharges BigInt                   @default(0)
  deductionAmount      BigInt                   @default(0)
  refundAmount         BigInt                   @default(0)
  outstandingAmount    BigInt                   @default(0)
  reviewedByUserId     String?
  reviewedBy           User?                    @relation("DepositSettlementReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  reviewedAt           DateTime?
  reviewNote           String?
  reviewIdempotencyKey String?                  @unique
  refundMethod         PaymentMethod?
  refundReference      String?
  refundNote           String?
  refundIdempotencyKey String?                  @unique
  refundedAt           DateTime?
  settledByUserId      String?
  settledBy            User?                    @relation("DepositSettlementCompleter", fields: [settledByUserId], references: [id], onDelete: Restrict)
  settledAt            DateTime?
  issues               DepositSettlementIssue[]
  outstandingInvoice   Invoice?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status, createdAt])
}

model DepositSettlementIssue {
  id                   String              @id @default(cuid())
  depositSettlementId  String
  depositSettlement    DepositSettlement   @relation(fields: [depositSettlementId], references: [id], onDelete: Cascade)
  returnInspectionId   String              @unique
  returnInspection     ReturnInspection    @relation(fields: [returnInspectionId], references: [id], onDelete: Restrict)
  issueType            InspectionIssueType
  approvedChargeAmount BigInt
  reason               String?
  reviewedByUserId     String
  reviewedBy           User                @relation("SettlementIssueReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  reviewedAt           DateTime            @default(now())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([depositSettlementId, returnInspectionId])
  @@index([depositSettlementId, issueType])
}

model RenewalRequest {
  id                String             @id @default(cuid())
  renewalCode       String             @unique
  reservationId     String
  reservation       Reservation        @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  status            RenewalStatus      @default(PENDING)
  previousEndDate   DateTime           @db.Date
  requestedEndDate  DateTime           @db.Date
  termMonths        Int
  paymentPlan       RenewalPaymentPlan
  quoteSnapshot     Json
  requestedByUserId String
  requestedBy       User               @relation("RenewalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedByUserId  String?
  reviewedBy        User?              @relation("RenewalReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  requestedAt       DateTime           @default(now())
  reviewedAt        DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  activeKey         String?            @unique
  idempotencyKey    String             @unique
  invoices          Invoice[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([reservationId, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id                         String                    @id @default(cuid())
  paymentCode                String                    @unique
  invoiceId                  String
  invoice                    Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount                     BigInt
  method                     PaymentMethod
  reference                  String?
  note                       String?
  receivedAt                 DateTime                  @default(now())
  recordedByUserId           String?
  recordedBy                 User?                     @relation("PaymentRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  onlinePaymentTransactionId String?                   @unique
  onlinePaymentTransaction   OnlinePaymentTransaction? @relation(fields: [onlinePaymentTransactionId], references: [id], onDelete: Restrict)
  verifiedSubmission         PaymentSubmission?        @relation("VerifiedSubmissionPayment")
  idempotencyKey             String                    @unique
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@index([invoiceId, receivedAt])
  @@index([recordedByUserId, receivedAt])
  @@index([method, receivedAt])
}

model PaymentSubmission {
  id                String                  @id @default(cuid())
  submissionCode    String                  @unique
  invoiceId         String
  invoice           Invoice                 @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerUserId    String
  customer          User                    @relation("PaymentSubmissionCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  amount            BigInt
  method            PaymentSubmissionMethod @default(BANK_TRANSFER)
  transferReference String?
  status            PaymentSubmissionStatus @default(PENDING_VERIFICATION)
  customerNote      String?
  submittedAt       DateTime                @default(now())
  reviewedByUserId  String?
  reviewedBy        User?                   @relation("PaymentSubmissionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  reviewedAt        DateTime?
  rejectionReason   String?
  idempotencyKey    String                  @unique
  verifiedPaymentId String?                 @unique
  verifiedPayment   Payment?                @relation("VerifiedSubmissionPayment", fields: [verifiedPaymentId], references: [id], onDelete: Restrict)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([invoiceId, status, submittedAt])
  @@index([customerUserId, submittedAt])
  @@index([status, submittedAt])
}

model OnlinePaymentTransaction {
  id                    String              @id @default(cuid())
  invoiceId             String
  invoice               Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customerUserId        String
  customer              User                @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  provider              PaymentProvider     @default(VNPAY)
  status                OnlinePaymentStatus @default(PENDING)
  amount                BigInt
  merchantOrderRef      String              @unique
  providerTransactionId String?             @unique
  responseCode          String?
  bankCode              String?
  paidAt                DateTime?
  idempotencyKey        String              @unique
  payment               Payment?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([invoiceId, status, createdAt])
  @@index([customerUserId, createdAt])
  @@index([provider, status, createdAt])
}

model HandoverAppointment {
  id                String            @id @default(cuid())
  appointmentCode   String            @unique
  reservationId     String
  reservation       Reservation       @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  status            AppointmentStatus @default(REQUESTED)
  scheduledAt       DateTime
  requestedByUserId String
  requestedBy       User              @relation("AppointmentRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  confirmedByUserId String?
  confirmedBy       User?             @relation("AppointmentConfirmer", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  completedByUserId String?
  completedBy       User?             @relation("AppointmentCompleter", fields: [completedByUserId], references: [id], onDelete: Restrict)
  note              String?
  handoverNote      String?
  confirmedAt       DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  activeKey         String?           @unique
  idempotencyKey    String            @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([reservationId, createdAt])
  @@index([status, scheduledAt])
  @@index([scheduledAt, id])
}
